        "editorTitle": "SAQL · sign-up rate by source",
        "lines": [
          "v = load \"visits\";",
          "s = load \"signups\";",
          "q = cogroup v by 'Source', s by 'Source';",
          "q = foreach q generate v.'Source' as 'Source',",
          "      sum(v.'Visits') as 'Visits', count(s) as 'Signups';",
          "q = foreach q generate 'Source', 'Signups' / 'Visits' as 'Rate';",
          "q = order q by 'Rate' desc;",
          "q = limit q 3;"
        ],
