      "transition": "bars",
      "vo": "Write real SAQL. Windowing, case statements, and date functions.",
      "props": {
        "kicker": "SAQL",
        "file": "academy_funnel.saql",
        "lines": [
          "q = load \"academy_funnel\";",
          "q = group q by ('Week', 'Source');",
          "q = foreach q generate 'Week', 'Source',",
          "  sum('Signups') as 'Signups',",
          "  sum(sum('Signups')) over ([..] partition by 'Source'",
          "    order by 'Week') as 'Running',",
          "  case when sum('Signups') > 50 then \"Hot\" else \"Warm\" end as 'Tier';",
          "q = order q by 'Week' asc;"
        ],
        "result": "52 weeks · 0.31 s"
