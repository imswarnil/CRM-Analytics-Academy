{
  "name": "crm-analytics-academy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "node scripts/prebuild.mjs && NODE_OPTIONS=--max-old-space-size=12288 nuxt build",
    "preview": "pnpm build && wrangler dev",
    "translate": "bash scripts/libretranslate.sh run -- node scripts/translate.mjs",
    "translate:setup": "bash scripts/libretranslate.sh setup",
    "lesson:meta": "node scripts/lesson-meta.mjs",
    "ask:index": "node scripts/build-search-index.mjs",
    "i18n:review": "node scripts/review-titles.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "org:pull": "cd salesforce && sf project retrieve start --metadata WaveDashboard WaveRecipe WaveDataflow WaveLens WaveApplication",
    "org:open": "cd salesforce && sf org open",
    "fcp": "node content-creation/lesson.mjs",
    "session": "node content-creation/session.mjs",
    "obs:install": "node content-creation/obs/install.mjs",
    "thumb": "node content-creation/thumbnails/make.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@iconify-json/vscode-icons": "^1.2.62",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/content": "^3.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/mdc": "^0.22.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@takumi-rs/core": "^1.8.7",
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.7.2",
    "h3": "^1.15.11",
    "minimark": "^0.2.0",
    "nuxt": "^4.4.8",
    "nuxt-og-image": "^6.7.0",
    "nuxt-studio": "^1.7.0",
    "tailwindcss": "^4.3.1",
    "ufo": "^1.6.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.127.1",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.9.0"
}
