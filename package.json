{
  "name": "nuxt-ui-template-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm build:static && pnpm build:worker",
    "build:static": "NITRO_PRESET=node-server NITRO_OUTPUT_DIR=.output-static nuxt build",
    "build:worker": "NITRO_PRESET=cloudflare_module NITRO_PRERENDER=false nuxt build",
    "deploy": "pnpm build && wrangler deploy",
    "generate": "nuxt generate",
    "dev": "bash scripts/dev.sh",
    "dev:raw": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "translate": "node --env-file-if-exists=.env scripts/translate.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@iconify-json/vscode-icons": "^1.2.62",
    "@microsoft/clarity": "^1.0.2",
    "@nuxt/content": "^3.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/mdc": "^0.22.0",
    "@takumi-rs/core": "^1.8.7",
    "@vueuse/core": "^14.3.0",
    "minimark": "^0.2.0",
    "nuxt": "^4.4.8",
    "nuxt-llms": "0.2.0",
    "nuxt-og-image": "^6.7.0",
    "tailwindcss": "^4.3.1",
    "ufo": "^1.6.4",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.6.0",
    "sass-embedded": "^1.103.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@11.9.0"
}
