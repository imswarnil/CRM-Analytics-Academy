{
  "name": "nuxt-ui-template-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm gate && NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "generate": "pnpm gate && NODE_OPTIONS=--max-old-space-size=8192 nuxt generate && pnpm verify:gating",
    "dev": "bash scripts/dev.sh",
    "dev:raw": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "translate": "node --env-file-if-exists=.env scripts/translate.mjs",
    "gate": "node scripts/gate-content.mjs",
    "verify:gating": "node scripts/verify-gating.mjs",
    "cf:dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && pnpm verify:gating && wrangler deploy",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@iconify-json/vscode-icons": "^1.2.62",
    "@microsoft/clarity": "^1.0.2",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/content": "^3.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/mdc": "^0.22.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@takumi-rs/core": "^1.8.7",
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.7.2",
    "minimark": "^0.2.0",
    "nuxt": "^4.4.8",
    "nuxt-llms": "0.2.0",
    "nuxt-og-image": "^6.7.0",
    "tailwindcss": "^4.3.1",
    "ufo": "^1.6.4",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@11.9.0"
}
