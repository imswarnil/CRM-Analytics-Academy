<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Academy_Seats_Positive</fullName>
    <active>true</active>
    <description>A deal with seats has at least one.</description>
    <errorDisplayField>Seats__c</errorDisplayField>
    <errorConditionFormula>AND(NOT(ISBLANK(Seats__c)), Seats__c &lt; 1)</errorConditionFormula>
    <errorMessage>Seats must be at least 1.</errorMessage>
</ValidationRule>
