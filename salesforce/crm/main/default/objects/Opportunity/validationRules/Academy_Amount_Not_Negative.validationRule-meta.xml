<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Academy_Amount_Not_Negative</fullName>
    <active>true</active>
    <description>Amounts are never negative; refunds are their own record.</description>
    <errorDisplayField>Amount</errorDisplayField>
    <errorConditionFormula>AND(NOT(ISBLANK(Amount)), Amount &lt; 0)</errorConditionFormula>
    <errorMessage>Amount cannot be negative.</errorMessage>
</ValidationRule>
