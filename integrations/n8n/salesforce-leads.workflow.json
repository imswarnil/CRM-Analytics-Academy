            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7c3aa13a-67f9-47c7-abdc-99e4c03986af",
              "leftValue": "={{ $json.signatureValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
