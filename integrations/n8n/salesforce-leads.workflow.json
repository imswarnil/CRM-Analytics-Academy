    {
      "id": "48a33f7b-03e0-472d-9fe3-1c202bcb04ea",
      "name": "Verify signature & map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Verifies X-Academy-Signature: sha256=<hex HMAC-SHA256 of the raw body>.\n// Needs: NODE_FUNCTION_ALLOW_BUILTIN=crypto and the secret in $env.ACADEMY_WEBHOOK_SECRET\n// (set N8N_BLOCK_ENV_ACCESS_IN_NODE=false), or paste it into SECRET below.\nconst crypto = require('crypto');\nconst SECRET = $env.ACADEMY_WEBHOOK_SECRET || '';\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst given = String(headers['x-academy-signature'] || '');\n\n// The exact bytes that were signed: the raw body when the webhook keeps it,\n// otherwise the parsed body re-serialised (identical for the Academy's compact JSON).\nlet raw;\nif (item.binary && item.binary.data && item.binary.data.data) {\n  raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n} else {\n  raw = JSON.stringify(item.json.body);\n}\nconst expected = 'sha256=' + crypto.createHmac('sha256', SECRET).update(raw).digest('hex');\nconst ok = SECRET.length > 0 && given.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected));\n\nconst body = typeof item.json.body === 'string' ? JSON.parse(item.json.body) : item.json.body;\nconst lead = (body && body.lead) || {};\nconst parts = String(lead.name || '').trim().split(/\\s+/);\nconst lastName = parts.length > 1 ? parts.pop() : (parts[0] || 'Unknown');\nconst firstName = parts.join(' ');\nconst details = lead.details || {};\nconst description = [\n  `Academy ${lead.type} request #${lead.id}`,\n  lead.message ? `Message: ${lead.message}` : '',\n  Object.keys(details).length ? 'Details: ' + Object.entries(details).map(([k, v]) => `${k}=${v}`).join('; ') : '',\n  lead.budget ? `Budget: ${lead.budget}` : '',\n  lead.sourcePage ? `Page: ${lead.sourcePage}` : '',\n  lead.utm && Object.keys(lead.utm).length ? 'UTM: ' + Object.entries(lead.utm).map(([k, v]) => `${k}=${v}`).join('; ') : '',\n  lead.enrichment && lead.enrichment.siteDescription ? `Company: ${lead.enrichment.siteDescription}` : ''\n].filter(Boolean).join('\\n');\n\nreturn [{ json: {\n  signatureValid: ok,\n  type: lead.type,\n  leadId: lead.id,\n  firstName,\n  lastName,\n  email: lead.email,\n  company: lead.company || lead.companyDomain || 'Unknown (individual)',\n  title: lead.role || '',\n  phone: lead.phone || '',\n  country: lead.country || '',\n  seats: lead.seats || null,\n  description\n} }];"
      }
    },
    {
