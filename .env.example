# Public URL, used for OG images when prerendering.
NUXT_PUBLIC_SITE_URL=

# LibreTranslate endpoint used by `pnpm translate` (scripts/translate.mjs).
# Deliberately not committed: the instance runs without an API key and this
# repository is public. In CI this is the LIBRETRANSLATE_URL repository variable
# (Settings -> Secrets and variables -> Actions -> Variables).
LIBRETRANSLATE_URL=
# Only needed if the instance has keyRequired enabled.
LIBRETRANSLATE_API_KEY=
