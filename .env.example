# Copy to .env and fill in. Never commit the filled version.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon pooled connection string — Neon console → Connect → Pooled connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — `neonctl neon-auth status --project-id <id>`
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# Any 64-char hex string: `python3 -c "import secrets;print(secrets.token_hex(32))"`
NEON_AUTH_COOKIE_SECRET=

# Demo account — server-side only, never exposed to the client.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# Adzuna job search (scripts/fetch-jobs.mjs) — free keys from developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Nuxt Studio (/_studio) — GitHub OAuth app, Settings → Developer settings →
# OAuth Apps. Callback URL: https://crmanalytics.imswarnil.com/__nuxt_studio/auth/github
# (http://localhost:3000/__nuxt_studio/auth/github for a local app).
# In production these are Worker secrets (`wrangler secret put`), not CI vars.
# These are the names nuxt-studio 1.7 reads from process.env (its docs also
# mention NUXT_STUDIO_AUTH_* — the code checks STUDIO_*).
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Optional: comma-separated emails allowed in; everyone who signs in otherwise.
STUDIO_GITHUB_MODERATORS=

# Content Studio (admin → Content tab). Fine-grained GitHub PAT with
# Contents: read & write on the content repo — nothing else. Server-side only,
# never sent to the client. Without it the studio's routes answer 503.
GITHUB_CONTENT_TOKEN=
# Optional owner/repo override; defaults to imswarnil/CRM-Analytics-Academy.
GITHUB_CONTENT_REPO=
