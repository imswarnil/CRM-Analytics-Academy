# Copy to .env and fill in. Never commit the filled version.
# In production every value below is a Worker secret (`wrangler secret put …`).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon pooled connection string — Neon console → Connect → Pooled connection.
# Create the tables once with: psql "$DATABASE_URL" -f server/db/schema.sql
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — `neonctl neon-auth status --project-id <id>`
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# Any 64-char hex string: `python3 -c "import secrets;print(secrets.token_hex(32))"`
NEON_AUTH_COOKIE_SECRET=

# Demo account — server-side only, never exposed to the client.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# The admin is fixed in code: ADMIN_EMAIL in server/utils/admin.ts.

# Ghost site whose newsletter POST /api/newsletter subscribes people to.
# Defaults to https://imswarnil.com.
NEWSLETTER_GHOST_URL=

# Nuxt Studio (/_studio) — the content editor. GitHub OAuth app, Settings →
# Developer settings → OAuth Apps. Callback URL:
#   https://crmanalytics.imswarnil.com/__nuxt_studio/auth/github
#   (http://localhost:3000/__nuxt_studio/auth/github for a local app)
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Optional: comma-separated GitHub emails allowed in.
STUDIO_GITHUB_MODERATORS=

# Translation needs nothing here: `pnpm translate:setup` installs LibreTranslate
# into .libretranslate/, and `pnpm build` / `pnpm translate` start and stop it.

# CI only (GitHub Actions secrets, never in .env): CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID deploy the Worker.

# Bot protection — Cloudflare Turnstile (dashboard → Turnstile → Add widget,
# hostname crmanalytics.imswarnil.com, mode "Managed"). Both empty = off.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Worker secret: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=
