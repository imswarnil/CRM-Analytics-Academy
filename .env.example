# Copy to .env and fill in. Never commit the filled version.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon pooled connection string — Neon console → Connect → Pooled connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — `neonctl neon-auth status --project-id <id>`
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# Any 64-char hex string: `python3 -c "import secrets;print(secrets.token_hex(32))"`
NEON_AUTH_COOKIE_SECRET=

# Demo account — server-side only, never exposed to the client.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# Comma-separated emails that are admins in /admin (every other signed-in
# account is a learner until an admin changes its role there).
ADMIN_EMAILS=

# Leads → n8n → Salesforce (integrations/n8n/). Unset ⇒ leads are stored and
# queued as `not_configured`; nothing is lost, nothing is forwarded.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Ghost site whose newsletter POST /api/newsletter subscribes people to.
# Defaults to https://imswarnil.com.
NEWSLETTER_GHOST_URL=

# Nuxt Studio (/_studio) — GitHub OAuth app, Settings → Developer settings →
# OAuth Apps. Callback URL: https://crmanalytics.imswarnil.com/__nuxt_studio/auth/github
# (http://localhost:3000/__nuxt_studio/auth/github for a local app).
# In production these are Worker secrets (`wrangler secret put`), not CI vars.
# These are the names nuxt-studio 1.7 reads from process.env (its docs also
# mention NUXT_STUDIO_AUTH_* — the code checks STUDIO_*).
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Optional: comma-separated emails allowed in; everyone who signs in otherwise.
STUDIO_GITHUB_MODERATORS=

# Content editor (admin → Content tab) and Lessons & Pro. Fine-grained GitHub
# PAT on the content repo with Contents: read & write and Pull requests: read &
# write (instructors' saves are pull requests) — nothing else. Server-side only,
# never sent to the client. Without it the editor's routes answer 503.
GITHUB_CONTENT_TOKEN=
# Optional owner/repo override; defaults to imswarnil/CRM-Analytics-Academy.
GITHUB_CONTENT_REPO=
# Optional branch the site deploys from; defaults to main.
GITHUB_CONTENT_BRANCH=

# Dodo Payments — Pro checkout. `test` until you switch the key and products to live.
MY_DODO_API_KEY=
DODO_ENV=test
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PRO_MONTHLY=
# Pro Annual is the featured plan on /pricing; without this id its checkout
# answers 503 "This plan is not available yet".
DODO_PRODUCT_PRO_ANNUAL=
# Team seats (/teams): a subscription product priced per seat per year.
DODO_PRODUCT_TEAM_SEAT=
# Legacy, no longer sold — kept so old purchases keep resolving.
DODO_PRODUCT_PRO_LIFETIME=
# Sponsorship: a ONE-TIME product, 99 USD, "one month of sponsorship". Checkout
# sells it × the number of months booked. Without it /sponsor shows the
# calendar but booking is disabled.
DODO_PRODUCT_SPONSOR_MONTH=

# Optional — live page views and countries on /sponsor, from Cloudflare's
# GraphQL Analytics API. A token with Zone → Analytics → Read on the zone, and the
# zone id (Cloudflare dashboard → the domain → Overview → Zone ID). Without
# them /sponsor shows only the database figures.
CF_API_TOKEN=
CF_ZONE_TAG=

# Promo slots in a month with no sponsor show the house placeholder. Set to
# `adsense` at BUILD time to show AdSense there instead. Off by default.
NUXT_PUBLIC_PROMO_NETWORK=

# Mux signed playback, for videos on Pro lessons (free lessons need nothing).
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_SECRET=

# Lesson video pipeline (pnpm video …, local only — see video/README.md).
# Mux API token for upload + caption sync; leave blank to use the `mux login` CLI instead.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# HeyGen, only if you select the heygen voice/avatar provider. Ids go in video/video.config.json.
HEYGEN_API_KEY=
# Optional override of HeyGen's API origin (scripts/video/lib/heygen.mjs).
HEYGEN_API_BASE=

# Translation (pnpm translate, scripts/translate.mjs) — a self-hosted
# LibreTranslate. In CI these are the LIBRETRANSLATE_URL repo variable and the
# LIBRETRANSLATE_API_KEY secret.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# CI only (GitHub Actions secrets, never in .env): CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID deploy the Worker; MUX_TOKEN_ID/SECRET run captions.yml.
