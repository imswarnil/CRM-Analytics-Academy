# Copy to .env and fill in. Never commit the filled version.
# In production every value below is a Worker secret (`wrangler secret put …`).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon pooled connection string — Neon console → Connect → Pooled connection.
# Create the tables once with: psql "$DATABASE_URL" -f server/db/schema.sql
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — `neonctl neon-auth status --project-id <id>`
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# Any 64-char hex string: `python3 -c "import secrets;print(secrets.token_hex(32))"`
NEON_AUTH_COOKIE_SECRET=

# Demo account — server-side only, never exposed to the client.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# The admin is fixed in code: ADMIN_EMAIL in server/utils/admin.ts.

# Ghost site whose newsletter POST /api/newsletter subscribes people to.
# Defaults to https://imswarnil.com.
NEWSLETTER_GHOST_URL=

# Nuxt Studio (/_studio) — the content editor. GitHub OAuth app, Settings →
# Developer settings → OAuth Apps. Callback URL:
#   https://crmanalytics.imswarnil.com/__nuxt_studio/auth/github
#   (http://localhost:3000/__nuxt_studio/auth/github for a local app)
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Optional: comma-separated GitHub emails allowed in.
STUDIO_GITHUB_MODERATORS=

# Translation needs nothing here: `pnpm translate:setup` installs LibreTranslate
# into .libretranslate/, and `pnpm build` / `pnpm translate` start and stop it.

# CI only (GitHub Actions secrets, never in .env): CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID deploy the Worker.

# The site's own captcha (server/utils/pow.ts). Optional: without it the key
# is derived from DATABASE_URL. Worker: wrangler secret put CAPTCHA_SECRET.
CAPTCHA_SECRET=

# Stripe (test mode first). Also set on the Worker: wrangler secret put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email journeys (Resend). Without the key nothing is sent; /admin → Emails previews.
RESEND_API_KEY=
EMAIL_FROM="Swarnil from CRM Analytics Academy <hello@imswarnil.com>"
EMAIL_REPLY_TO=contact@imswarnil.com

# Salesforce account sync (server/utils/sf-sync.ts), optional. Without all three
# the hourly sync is a no-op that reports "not configured". OAuth 2.0 client
# credentials of an External Client App with an API-only run-as user — setup in
# salesforce/CRM-PROCESS.md → "Account sync". Leads use Web-to-Lead and need nothing.
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# SF_API_VERSION=v62.0
# Per-run caps (defaults 400 records, 12 API calls).
# SF_SYNC_MAX_RECORDS=400
# SF_SYNC_MAX_CALLS=12

# Optional paid enrichment by email DOMAIN only (never the email). Off unless set.
# {domain} is replaced; the key is sent as a Bearer token.
# ENRICH_PROVIDER_URL=https://provider.example/v1/companies?domain={domain}
# ENRICH_PROVIDER_KEY=

# Prospecting (/admin → Prospecting), all optional — docs/PROSPECTING.md.
# Each provider switches on with its key; without one the tools say "connect a provider".
APOLLO_API_KEY=
HUNTER_API_KEY=
# Adapter slots, not implemented yet: PDL_API_KEY, SNOV_CLIENT_ID, PROSPEO_API_KEY
# Outreach is sent from your own Gmail (Google Workspace) via OAuth — never Resend.
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
