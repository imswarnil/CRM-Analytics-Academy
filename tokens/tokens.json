{
  "$description": "CRM Analytics Academy — Blueprint design tokens (W3C Design Tokens format). Mirrors app/assets/css/main.css, which stays the source of truth for the website. Import into Figma (Tokens Studio), or read the values off for Final Cut Pro, Premiere, After Effects and Keynote.",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Schibsted Grotesk", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"], "$description": "Everything you read: headings, body, buttons. Google Fonts, OFL." },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "SF Mono", "Menlo", "monospace"], "$description": "Everything that labels: eyebrows, figure captions, specs, code, timestamps. Google Fonts, OFL." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 },
      "black": { "$type": "fontWeight", "$value": 900 }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 900, "fontSize": "76px", "lineHeight": 0.95, "letterSpacing": "-0.045em" },
      "$description": ".bp-h1 — hero headlines. Fluid on the web: clamp(42px, 6.2vw, 76px). On a 1080p frame use 120–140px."
    },
    "h2": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 800, "fontSize": "48px", "lineHeight": 1, "letterSpacing": "-0.04em" },
      "$description": ".bp-h2 — section titles. clamp(30px, 4vw, 48px)."
    },
    "h3": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 800, "fontSize": "22px", "lineHeight": 1.15, "letterSpacing": "-0.02em" },
      "$description": ".bp-h3 — card and block titles."
    },
    "lead": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "19px", "lineHeight": 1.6, "letterSpacing": "0" },
      "$description": ".bp-lead — standfirsts under a title. clamp(16px, 1.4vw, 19px), colour ink2."
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.7, "letterSpacing": "0" }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 500, "fontSize": "11px", "lineHeight": 1.3, "letterSpacing": "0.14em", "textTransform": "uppercase" },
      "$description": ".eyebrow — \"FIG. 05 — THE AUTHOR\", \"SHEET 02 /\". Colour signal."
    },
    "label": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": "10px", "lineHeight": 1.3, "letterSpacing": "0.1em", "textTransform": "uppercase" },
      "$description": ".mono-label — specs, legends, axis ticks. Colour ink2."
    }
  },
  "color": {
    "light": {
      "paper": { "$type": "color", "$value": "#F4F7FB", "$description": "Page background" },
      "paper2": { "$type": "color", "$value": "#E8EFF8", "$description": "Muted background" },
      "card": { "$type": "color", "$value": "#FBFCFE", "$description": "Card surface" },
      "ink": { "$type": "color", "$value": "#0C1B33", "$description": "Text, borders, hard shadows" },
      "ink2": { "$type": "color", "$value": "#4A5B78", "$description": "Secondary text" },
      "line": { "$type": "color", "$value": "#C3D2E6", "$description": "Hairlines, dashed rules" },
      "navy": { "$type": "color", "$value": "#0F2A5C", "$description": "Footer, dark bands" },
      "signal": { "$type": "color", "$value": "#2F5BEA", "$description": "THE accent: links, primary buttons, eyebrows" },
      "tide": { "$type": "color", "$value": "#3D8BD9", "$description": "Chart mid tone" },
      "frost": { "$type": "color", "$value": "#A8CCF2", "$description": "Chart light tone" },
      "ice": { "$type": "color", "$value": "#DDEBFA", "$description": "Active / hover fill" },
      "glow": { "$type": "color", "$value": "#3FC6DC", "$description": "Cyan, sparingly: done states, labels on navy" }
    },
    "dark": {
      "paper": { "$type": "color", "$value": "#0A1428" },
      "paper2": { "$type": "color", "$value": "#0D1A33" },
      "card": { "$type": "color", "$value": "#0F1C36" },
      "ink": { "$type": "color", "$value": "#E6EEFA" },
      "ink2": { "$type": "color", "$value": "#9DB0CF" },
      "line": { "$type": "color", "$value": "#24385F" },
      "navy": { "$type": "color", "$value": "#07122A" },
      "signal": { "$type": "color", "$value": "#6E93FF" },
      "tide": { "$type": "color", "$value": "#5BA6EC" },
      "frost": { "$type": "color", "$value": "#2B4A7C" },
      "ice": { "$type": "color", "$value": "#16274A" },
      "glow": { "$type": "color", "$value": "#5ED8EA" }
    },
    "ramp": {
      "blueprint": {
        "50": { "$type": "color", "$value": "#F4F7FB" }, "100": { "$type": "color", "$value": "#DDEBFA" }, "200": { "$type": "color", "$value": "#A8CCF2" },
        "300": { "$type": "color", "$value": "#7FB2EA" }, "400": { "$type": "color", "$value": "#3D8BD9" }, "500": { "$type": "color", "$value": "#2F5BEA" },
        "600": { "$type": "color", "$value": "#2549C4" }, "700": { "$type": "color", "$value": "#1C3A9C" }, "800": { "$type": "color", "$value": "#15306F" },
        "900": { "$type": "color", "$value": "#0F2A5C" }, "950": { "$type": "color", "$value": "#07122A" }
      },
      "glow": {
        "50": { "$type": "color", "$value": "#ECFAFD" }, "100": { "$type": "color", "$value": "#CFF3F8" }, "200": { "$type": "color", "$value": "#A3E7F1" },
        "300": { "$type": "color", "$value": "#6FD8E8" }, "400": { "$type": "color", "$value": "#3FC6DC" }, "500": { "$type": "color", "$value": "#22AEC6" },
        "600": { "$type": "color", "$value": "#1B8CA2" }, "700": { "$type": "color", "$value": "#1A6F82" }, "800": { "$type": "color", "$value": "#1B5A69" },
        "900": { "$type": "color", "$value": "#1A4B58" }, "950": { "$type": "color", "$value": "#0B303A" }
      },
      "ink": {
        "50": { "$type": "color", "$value": "#F4F7FB" }, "100": { "$type": "color", "$value": "#E8EFF8" }, "200": { "$type": "color", "$value": "#C3D2E6" },
        "300": { "$type": "color", "$value": "#A3B5CF" }, "400": { "$type": "color", "$value": "#7E93B5" }, "500": { "$type": "color", "$value": "#5E7295" },
        "600": { "$type": "color", "$value": "#4A5B78" }, "700": { "$type": "color", "$value": "#33445F" }, "800": { "$type": "color", "$value": "#1E2E4A" },
        "900": { "$type": "color", "$value": "#0C1B33" }, "950": { "$type": "color", "$value": "#07122A" }
      }
    }
  },
  "border": {
    "ink": { "$type": "border", "$value": { "color": "{color.light.ink}", "width": "1.5px", "style": "solid" }, "$description": "Every card, button and figure frame" },
    "hairline": { "$type": "border", "$value": { "color": "{color.light.line}", "width": "1px", "style": "solid" } },
    "rule": { "$type": "border", "$value": { "color": "{color.light.line}", "width": "1px", "style": "dashed" }, "$description": "Between list rows and above h2s in lessons" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "Square corners everywhere. Only donuts and dots are round." }
  },
  "shadow": {
    "hard-sm": { "$type": "shadow", "$value": { "color": "{color.light.ink}", "offsetX": "3px", "offsetY": "3px", "blur": "0px", "spread": "0px" } },
    "hard": { "$type": "shadow", "$value": { "color": "{color.light.ink}", "offsetX": "5px", "offsetY": "5px", "blur": "0px", "spread": "0px" } },
    "hard-signal": { "$type": "shadow", "$value": { "color": "{color.light.signal}", "offsetX": "10px", "offsetY": "10px", "blur": "0px", "spread": "0px" }, "$description": "Navy call-to-action bands" }
  },
  "grid": {
    "minor": { "$type": "dimension", "$value": "24px", "$description": "Graph paper minor line" },
    "major": { "$type": "dimension", "$value": "120px", "$description": "Every fifth line, slightly darker" }
  },
  "motion": {
    "ease-bounce": { "$type": "cubicBezier", "$value": [0.3, 1.5, 0.5, 1], "$description": "Icon nudges, hover lifts" },
    "ease-out": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "$description": "Everything else" },
    "instant": { "$type": "duration", "$value": "150ms" },
    "quick": { "$type": "duration", "$value": "250ms" }
  },
  "video": {
    "frame-1080p": { "$type": "dimension", "$value": "1920x1080", "$description": "Lessons, YouTube. 30 fps." },
    "frame-vertical": { "$type": "dimension", "$value": "1080x1920", "$description": "Shorts, Reels" },
    "frame-square": { "$type": "dimension", "$value": "1080x1080", "$description": "LinkedIn / Instagram feed" },
    "frame-carousel": { "$type": "dimension", "$value": "1080x1350", "$description": "LinkedIn document carousel (4:5)" },
    "safe-title": { "$type": "dimension", "$value": "96px", "$description": "Inset from every edge for type on a 1080p frame" },
    "lower-third-height": { "$type": "dimension", "$value": "132px" }
  }
}
