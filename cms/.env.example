# The site's Neon database. Payload keeps everything in its own `payload`
# schema and never touches `app` or `neon_auth`.
DATABASE_URL=
# Any long random string; signs admin sessions. `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Optional: Cloudflare R2 for uploads. Unset = files go to ../public/cms-media,
# which the site serves as static assets.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
