# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# VSC
.history

# Personal reference PDFs (not part of the site)
pdfs/
/*.pdf

# The LinkedIn launch kit (post, carousel, screenshots) stays local.
linkedin/

# Salesforce project material lives in salesforce/ (see salesforce/README.md).
# Keys, certificates and auth files in it must never reach the public repo.
salesforce/**/*.key
salesforce/**/*.crt
salesforce/**/auth*.json

# Cloudflare / wrangler
.wrangler/
.dev.vars
.dev.vars.*
.output-static/

# Generated by scripts/build-search-index.mjs before each build
public/ask-index.json
public/search/
public/llms.txt
public/llms-full.txt
public/*/llms.txt
public/raw/
public/exam/

# Salesforce CLI auth state. `.sf/` and `.sfdx/` hold ORG ACCESS TOKENS — a
# refresh token in one of these is a live, password-free login to the org, so
# they must never be committed, in this repo or any other.
.sf/
.sfdx/
salesforce/.sf/
salesforce/.sfdx/
salesforce/node_modules/

# Retrieved org metadata is NOT committed wholesale. A freshly provisioned CRM
# Analytics dev org ships ~27 Salesforce sample dashboards (Larry's Laptop
# Emporium, The Motivator, the Trailhead samples); committing those to a public
# repo redistributes Salesforce's content and buries the Academy builds this
# course is actually about. Retrieve freely, commit deliberately:
#   sf project retrieve start …   # refresh the local mirror
#   git add -f salesforce/force-app/main/default/wave/Academy_*.wdash
salesforce/force-app/main/default/wave/

# Agent worktrees
.claude/worktrees/

# Local LibreTranslate (venv + models), see scripts/libretranslate.sh
.libretranslate/

# Final Cut Pro (content-creation/): recordings, exports and build scratch stay local.
# `pnpm fcp <route>` output is regenerated on demand and holds this machine's
# absolute media paths; only the Lesson 01 reference project is kept.
content-creation/projects/*/
!content-creation/projects/lesson-01-developer-org/
content-creation/projects/*/media/
content-creation/projects/*/*.mp4
content-creation/projects/*/*.mov
content-creation/projects/*/*.fcpbundle/
content-creation/kit/Music/*.wav
content-creation/source/build_audio/
content-creation/source/**/__pycache__/

# YouTube thumbnails: generated output (pnpm thumb) stays local.
content-creation/thumbnails/out/
# Recording sessions (pnpm session): the takes, music and generated projects stay on this machine.
content-creation/sessions/
content-creation/music/
content-creation/tools/.bin/
content-creation/obs/live/

# Pro lessons — generated by scripts/gate-content.mjs on every build.
.gated-stubs/
.gated-files.json
server/assets/gated/
